{
  "name": "faycli",
  "version": "1.0.0",
  "description": "Autonomous AI Agent CLI optimized for Termux Android environment",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "faycli": "./bin/faycli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "node scripts/test-e2e.js",
    "test:all": "node --test tests/*.test.js tests/e2e/*.test.js",
    "benchmark": "node scripts/benchmark.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "commitlint": "commitlint --from origin/main",
    "commitlint:check": "commitlint --edit"
  },
  "keywords": [
    "termux",
    "ai",
    "cli",
    "agent",
    "gemini",
    "react-loop",
    "android"
  ],
  "author": "FAYnim",
  "license": "MIT",
  "files": [
    "bin/",
    "src/",
    "locales/",
    "install.sh",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2"
  }
}
